<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="root" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tieu_luan.sapxeplichlv.ManagerScheduleController">
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="80.0" spacing="30.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" prefHeight="50.0" prefWidth="80.0" styleClass="logo-label" text="M" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#onHomeClick" prefHeight="50.0" prefWidth="50.0" styleClass="sidebar-button,active-sidebar-button">
               <graphic>
                  <Label styleClass="icon-label" text="H" />
               </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#onEmployeesClick" prefHeight="50.0" prefWidth="50.0" styleClass="sidebar-button">
               <graphic>
                  <Label styleClass="icon-label" text="E" />
               </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#onPositionsClick" prefHeight="50.0" prefWidth="50.0" styleClass="sidebar-button">
               <graphic>
                  <Label styleClass="icon-label" text="P" />
               </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#onShiftsClick" prefHeight="50.0" prefWidth="50.0" styleClass="sidebar-button">
               <graphic>
                  <Label styleClass="icon-label" text="S" />
               </graphic>
            </Button>
            <Pane VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onLogoutClick" prefHeight="50.0" prefWidth="50.0" styleClass="sidebar-button">
               <graphic>
                  <Label styleClass="icon-label" text="L" />
               </graphic>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <AnchorPane prefHeight="600.0" prefWidth="820.0" BorderPane.alignment="CENTER">
         <children>
            <TabPane prefHeight="600.0" prefWidth="820.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <tabs>
                  <Tab text="Schedule">
                     <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutX="15.0" layoutY="15.0" prefHeight="540.0" prefWidth="790.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="785.0" spacing="20.0">
                                       <children>
                                          <Label fx:id="monthYearLabel" styleClass="title-label" text="Work Schedule - February 2022">
                                             <font>
                                                <Font size="24.0" />
                                             </font>
                                          </Label>
                                          <Pane HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#onPreviousMonthClick" styleClass="nav-button" text="&lt;" />
                                          <Button mnemonicParsing="false" onAction="#onNextMonthClick" styleClass="nav-button" text="&gt;" />
                                          <Button mnemonicParsing="false" onAction="#onGenerateScheduleClick" prefHeight="40.0" prefWidth="180.0" styleClass="primary-button" text="Generate Schedule" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="200.0" spacing="10.0">
                                       <children>
                                          <ToggleButton mnemonicParsing="false" onAction="#onDayViewClick" prefHeight="30.0" prefWidth="80.0" styleClass="view-toggle-button" text="Day View">
                                             <toggleGroup>
                                                <ToggleGroup fx:id="viewToggleGroup" />
                                             </toggleGroup>
                                          </ToggleButton>
                                          <ToggleButton mnemonicParsing="false" onAction="#onWeekViewClick" prefHeight="30.0" prefWidth="80.0" styleClass="view-toggle-button" text="Week View" toggleGroup="$viewToggleGroup" />
                                          <ToggleButton mnemonicParsing="false" onAction="#onMonthViewClick" prefHeight="30.0" prefWidth="80.0" selected="true" styleClass="view-toggle-button,active-toggle-button" text="Month View" toggleGroup="$viewToggleGroup" />
                                       </children>
                                    </HBox>
                                    <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="440.0" prefWidth="785.0" styleClass="schedule-pane" VBox.vgrow="ALWAYS">
                                       <content>
                                          <GridPane fx:id="calendarGrid" hgap="2.0" prefHeight="435.0" prefWidth="780.0" vgap="2.0">
                                             <columnConstraints>
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                             </columnConstraints>
                                             <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                             </rowConstraints>
                                             <children>
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Mon" textAlignment="CENTER" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Tue" textAlignment="CENTER" GridPane.columnIndex="1" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Wed" textAlignment="CENTER" GridPane.columnIndex="2" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Thu" textAlignment="CENTER" GridPane.columnIndex="3" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Fri" textAlignment="CENTER" GridPane.columnIndex="4" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Sat" textAlignment="CENTER" GridPane.columnIndex="5" />
                                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="200.0" text="Sun" textAlignment="CENTER" GridPane.columnIndex="6" />
                                             </children>
                                             <padding>
                                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                             </padding>
                                          </GridPane>
                                       </content>
                                    </ScrollPane>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
                  <Tab text="Requests">
                     <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutX="15.0" layoutY="15.0" prefHeight="540.0" prefWidth="790.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="785.0" spacing="20.0">
                                       <children>
                                          <Label styleClass="title-label" text="Pending Requests">
                                             <font>
                                                <Font size="24.0" />
                                             </font>
                                          </Label>
                                          <Pane HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#onRefreshRequestsClick" prefHeight="40.0" prefWidth="100.0" styleClass="secondary-button" text="Refresh" />
                                       </children>
                                    </HBox>
                                    <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="480.0" prefWidth="790.0" styleClass="content-pane" VBox.vgrow="ALWAYS">
                                       <content>
                                          <VBox fx:id="requestListContainer" prefHeight="475.0" prefWidth="788.0" spacing="10.0">
                                             <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                             </padding>
                                          </VBox>
                                       </content>
                                    </ScrollPane>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>